DATABASE_URL="postgresql://..."
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Requerida para conectar una máquina de pago (Mercado Pago Point) en
# Configuración — cifra el access token antes de guardarlo en la base de
# datos. Sin esta variable, conectar la máquina falla con un error claro
# (nunca se guarda el token sin cifrar). Generar con: openssl rand -base64 32
PAGOS_ENCRYPTION_KEY=""

# Requeridas para cobrar con un lector SumUp conectado (Configuración).
# A diferencia de la API Key y el código de comercio (que son de cada local
# y se guardan cifrados en la base de datos), esta es la Affiliate Key de
# la integración de Nelyx — UNA sola, compartida por todos los locales que
# usen SumUp. Se genera una sola vez desde la cuenta de SumUp que registra
# la app: Ajustes → Para desarrolladores → Claves de Afiliado → "+ Añadir
# ID de aplicación" (usa un identificador sin espacios, estilo
# "com.nelyx.app"). Sin estas variables, SumUp responde siempre
# "Invalid affiliate key" — nunca hay un modo de respaldo.
SUMUP_AFFILIATE_APP_ID=""
SUMUP_AFFILIATE_KEY=""

# Opcional — habilita las respuestas automáticas por IA del chat de soporte
# (lib/soporte-ia.ts) y la sugerencia de emoji cuando un producto escaneado
# no calza con ninguna palabra clave local (lib/emoji-ia.ts). Es una cuenta
# de API aparte de cualquier cuenta personal de Claude — se genera en
# console.anthropic.com. Sin esta variable, ambas funciones simplemente no
# actúan (caen al comportamiento de siempre), nunca fallan la app.
ANTHROPIC_API_KEY=""

# Opcional — monitoreo de errores (ver SENTRY_SETUP.md). Sin esto, la
# plataforma funciona exactamente igual, solo sin avisos automáticos de
# errores internos.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Requerida para que /api/cron/notificaciones (alertas de stock,
# recordatorios de cobranza/calendario/cumpleaños, limpieza de adjuntos)
# funcione — sin esta variable, el cron queda inactivo (401 en cada
# ejecución, sin ningún aviso visible salvo en los logs). Debe coincidir
# con el secret configurado en el cron de Vercel (vercel.json o el
# scheduler del dashboard). Generar con: openssl rand -base64 32
CRON_SECRET=""

# Requeridas para enviar notificaciones push al navegador/celular
# (lib/push.ts, Configuración → Notificaciones). Sin estas, el push
# simplemente no se envía (no falla la app). Generar con:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Mismo valor que VAPID_PUBLIC_KEY — se repite con prefijo NEXT_PUBLIC_
# porque el navegador necesita la clave pública para suscribirse, y solo
# las variables con ese prefijo llegan al bundle del cliente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Requerida para conectar BCI Pagos (Configuración) — URL base de su API,
# no documentada públicamente: hay que pedírsela a BCI Pagos junto con las
# credenciales del comercio.
BCIPAGOS_API_URL=""

# Requeridas para enviar correos transaccionales (invitación de cliente
# nuevo, recuperar contraseña — ver lib/email.ts). Sin RESEND_API_KEY, el
# envío simplemente no ocurre (no falla la app, pero el correo nunca
# llega). Se genera en resend.com.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Requerida para subir adjuntos al chat de Soporte (Vercel Blob). Se crea
# automáticamente al conectar un Blob Store al proyecto en Vercel —
# normalmente no hace falta setearla a mano en local salvo que se quiera
# probar esa subida fuera de Vercel.
BLOB_READ_WRITE_TOKEN=""
