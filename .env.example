DATABASE_URL="postgresql://..."
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Requerida para conectar una máquina de pago (Mercado Pago Point) en
# Configuración — cifra el access token antes de guardarlo en la base de
# datos. Sin esta variable, conectar la máquina falla con un error claro
# (nunca se guarda el token sin cifrar). Generar con: openssl rand -base64 32
PAGOS_ENCRYPTION_KEY=""

# Opcional — monitoreo de errores (ver SENTRY_SETUP.md). Sin esto, la
# plataforma funciona exactamente igual, solo sin avisos automáticos de
# errores internos.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
